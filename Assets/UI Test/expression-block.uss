.expr-block
{
    min-width: 40px;
    min-height: 28px;

    flex-direction: row;
    align-items: center;

    background-color: rgb(50,50,50);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(25,25,25);

    padding: 2px;

    transition-property: border-color;
    transition-duration: 0.15s;
}

.expr-eval
{
    border-color: rgb(255,200,0);
}

.expr-slot
{
    min-width: 40px;
    min-height: 28px;

    margin: 2px;

    background-color: rgb(70,70,70);
    border-radius: 4px;

    align-items: center;
    justify-content: center;
}

.expr-separator
{
    margin-left: 4px;
    margin-right: 4px;

    -unity-font-style: bold;
    font-size: 14px;

    color: rgb(200,200,200);
}



.expr-input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 60px;
}

.expr-toolbar
{
    flex-direction: row;
    height: 30px;

    background-color: rgb(40,40,40);

    padding-left: 6px;
    padding-right: 6px;

    align-items: center;
}

.stmt-block
{
    min-width: 140px;
    min-height: 38px;

    flex-direction: column;
    align-items: flex-start;

    background-color: rgb(70,40,40);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(35,20,20);

    padding: 4px;

    transition-property: border-color;
    transition-duration: 0.15s;
}

.stmt-title
{
    color: rgb(220,220,120);
    font-weight: bold;
}

.stmt-slot
{
    min-width: 80px;
    min-height: 24px;

    margin: 2px;
    flex-direction: column;
    align-items: flex-start;
}

.stmt-slot-placeholder
{
    min-width: 80px;
    min-height: 24px;

    background-color: rgb(55,55,100);
    border-radius: 4px;
    border-width: 2px;
    border-color: black;
}

.stmt-eval
{
    border-color: rgb(255,200,0);
}

.expr-selected
{
    border-width: 2px;
    border-color: yellow;
}