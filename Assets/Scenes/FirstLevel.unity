      value: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
        \u0432 \u043A\u043E\u043D\u0441\u043E\u043B\u044C System Overflow. \u0412\u0437\u043B\u043E\u043C
        \u0440\u043E\u0431\u043E\u0442\u043E\u0432 - \u0432\u0430\u0448\u0430 \u0433\u043B\u0430\u0432\u043D\u0430\u044F
        \u0437\u0430\u0434\u0430\u0447\u0430. \u0411\u0443\u0434\u044C\u0442\u0435
        \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B. \u0414\u043B\u044F
        \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
