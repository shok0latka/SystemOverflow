<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/SOScript/Script.UI/expression-block.uss?fileID=7433441132597879392&amp;guid=8c7348551ba62f4409ddbb595cb57267&amp;type=3#expression-block" />
    <ui:VisualElement name="SO_Script_Editor" style="flex-grow: 1; flex-direction: row-reverse;">
        <ui:VisualElement name="Editor" class="so-editor" style="flex-grow: 1;">
            <ui:VisualElement name="Field" class="editor-field" style="visibility: hidden;" />
        </ui:VisualElement>
        <ui:VisualElement name="Elements" tabindex="1" class="so-elements" style="width: 20%; flex-grow: 0; position: relative; min-width: 250px; max-width: 500px;">
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" vertical-scroller-visibility="AlwaysVisible" mouse-wheel-scroll-size="1000" style="flex-grow: 0; font-size: 24px; height: 100%;">
                <ui:Foldout text="Expressions" value="false" name="Expressions" style="margin-right: 20px;">
                    <ui:Foldout text="Binary" name="BinaryExpressions" value="false">
                        <ui:Foldout text="Arithmetics" name="Arithmetics" value="false" />
                        <ui:Foldout text="Comparison" name="Comparison" value="false" />
                    </ui:Foldout>
                    <ui:Foldout text="Literal" name="LiteralExpressions" value="false" />
                </ui:Foldout>
                <ui:Foldout text="Control Flow Statements" name="ControlFlowStmts" value="false" style="margin-right: 20px;" />
                <ui:Foldout text="Variables" name="Variables" style="margin-right: 20px;">
                    <ui:Foldout text="Create" name="VarCreate" value="true">
                        <ui:VisualElement name="StringVarCreation" class="var-creation">
                            <ui:TextField picking-mode="Ignore" label="String:  " value="Name" name="Name" style="flex-direction: row; align-items: stretch; justify-content: space-between; align-self: auto;" />
                            <ui:Button text="+" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Add" style="border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; width: 40px; height: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: auto; font-size: 30px; -unity-font-style: bold; align-self: center;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="FloatVarCreation" class="var-creation">
                            <ui:TextField picking-mode="Ignore" label="Float: " value="Name" name="Name" style="flex-direction: row; align-items: stretch; justify-content: space-between; align-self: stretch;" />
                            <ui:Button text="+" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Add" style="border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; width: 40px; height: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: auto; font-size: 30px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="IntVarCreation" class="var-creation">
                            <ui:TextField picking-mode="Ignore" label="Integer: " value="Name" name="Name" style="flex-direction: row; align-items: stretch; justify-content: space-between; align-self: stretch;" />
                            <ui:Button text="+" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Add" style="border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; width: 40px; height: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: auto; font-size: 30px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="BoolVarCreation" class="var-creation">
                            <ui:TextField picking-mode="Ignore" label="Boolean: " value="Name" name="Name" style="flex-direction: row; align-items: stretch; justify-content: space-between; align-self: stretch;" />
                            <ui:Button text="+" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Add" style="border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; width: 40px; height: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: auto; font-size: 30px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:Foldout>
                    <ui:Foldout text="List" name="VarList" value="false" />
                </ui:Foldout>
                <ui:Foldout text="Messages" name="Messages" value="false" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Toolbar" class="expr-toolbar" style="flex-grow: 0; display: flex; height: 100px; border-top-width: 4px; border-top-color: rgb(0, 0, 0); flex-direction: row; font-size: 24px; background-color: rgb(128, 128, 128); max-height: 100px; min-height: 100px;">
        <ui:Button text="Execute" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Execute" class="toolbar-button" />
        <ui:Label tabindex="-1" text="Result:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Result" style="margin-left: 20px;" />
        <ui:Button text="Delete" parse-escape-sequences="true" display-tooltip-when-elided="true" name="DeleteSelection" class="toolbar-button" style="margin-left: auto; margin-right: 20px;" />
    </ui:VisualElement>
</ui:UXML>
